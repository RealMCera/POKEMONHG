$(TITLEDEMO_NARC): $(addprefix $(TITLEDEMO_DIR)/,$(TITLEDEMO_DEPS))

.PHONY: clean-titledemo
clean-filesystem: clean-titledemo

VERSION101_SOPC_8BPP_NCGR_FILES += $(TITLEDEMO_8BPP_NCGR)
VERSION101_SOPC_NCGR_FILES      += $(TITLEDEMO_4BPP_NCGR)


# First Movie static title screens.
FIRST_MOVIE_TITLE_SRC_DIR := .first_movie/title
FIRST_MOVIE_TITLE_GEN_DIR := $(TITLEDEMO_DIR)/first_movie_generated
FIRST_MOVIE_TITLE_TOP_SRC := $(FIRST_MOVIE_TITLE_SRC_DIR)/top.png
FIRST_MOVIE_TITLE_BOTTOM_SRC := $(FIRST_MOVIE_TITLE_SRC_DIR)/bottom.png
FIRST_MOVIE_TITLE_PREP := tools/first_movie_title/prepare_title_assets.py

FIRST_MOVIE_TITLE_TOP_INDEXED := $(FIRST_MOVIE_TITLE_GEN_DIR)/first_movie_top.indexed.png
FIRST_MOVIE_TITLE_BOTTOM_INDEXED := $(FIRST_MOVIE_TITLE_GEN_DIR)/first_movie_bottom.indexed.png
FIRST_MOVIE_TITLE_TOP_JSON := $(FIRST_MOVIE_TITLE_GEN_DIR)/first_movie_top.json
FIRST_MOVIE_TITLE_BOTTOM_JSON := $(FIRST_MOVIE_TITLE_GEN_DIR)/first_movie_bottom.json

$(FIRST_MOVIE_TITLE_TOP_INDEXED) $(FIRST_MOVIE_TITLE_BOTTOM_INDEXED) $(FIRST_MOVIE_TITLE_TOP_JSON) $(FIRST_MOVIE_TITLE_BOTTOM_JSON): $(FIRST_MOVIE_TITLE_TOP_SRC) $(FIRST_MOVIE_TITLE_BOTTOM_SRC) $(FIRST_MOVIE_TITLE_PREP)
	python $(FIRST_MOVIE_TITLE_PREP) --top $(FIRST_MOVIE_TITLE_TOP_SRC) --bottom $(FIRST_MOVIE_TITLE_BOTTOM_SRC) --out-dir $(FIRST_MOVIE_TITLE_GEN_DIR)

$(TITLEDEMO_DIR)/titledemo_00000044.NCGR: $(FIRST_MOVIE_TITLE_TOP_INDEXED)
	$(GFX) $< $@ -version101 -sopc -bitdepth 8

$(TITLEDEMO_DIR)/titledemo_00000045.NSCR: $(FIRST_MOVIE_TITLE_TOP_JSON)
	$(GFX) $< $@ -bitdepth 8

$(TITLEDEMO_DIR)/titledemo_00000046.NCLR: $(FIRST_MOVIE_TITLE_TOP_INDEXED)
	$(GFX) $< $@ -bitdepth 8 -nopad

$(TITLEDEMO_DIR)/titledemo_00000047.NCGR: $(FIRST_MOVIE_TITLE_BOTTOM_INDEXED)
	$(GFX) $< $@ -version101 -sopc -bitdepth 8

$(TITLEDEMO_DIR)/titledemo_00000048.NSCR: $(FIRST_MOVIE_TITLE_BOTTOM_JSON)
	$(GFX) $< $@ -bitdepth 8

$(TITLEDEMO_DIR)/titledemo_00000049.NCLR: $(FIRST_MOVIE_TITLE_BOTTOM_INDEXED)
	$(GFX) $< $@ -bitdepth 8 -nopad

clean-titledemo:
	$(RM) $(TITLEDEMO_NARC) $(TITLEDEMO_4BPP_NCGR) $(TITLEDEMO_8BPP_NCGR)
	$(RM) -r $(FIRST_MOVIE_TITLE_GEN_DIR)
	$(RM) $(TITLEDEMO_DIR)/titledemo_00000044.NCGR $(TITLEDEMO_DIR)/titledemo_00000045.NSCR $(TITLEDEMO_DIR)/titledemo_00000046.NCLR
	$(RM) $(TITLEDEMO_DIR)/titledemo_00000047.NCGR $(TITLEDEMO_DIR)/titledemo_00000048.NSCR $(TITLEDEMO_DIR)/titledemo_00000049.NCLR
