<?xml version="1.0"?>
<body language="English">
	<row id="msg_0544_T20R0102_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">A man in a dark suit studies you from behind the glass.\rGiovanni: So this is the creature they built.</language>
	</row>
	<row id="msg_0544_T20R0102_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Giovanni: Power without discipline is useless.\rShow me what you can do.</language>
	</row>
	<row id="msg_0544_T20R0102_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Giovanni: Again.\rNo hesitation this time.</language>
	</row>
	<row id="msg_0544_T20R0102_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Giovanni: Enough.\rYou have strength. Now we find out whether you can be controlled.</language>
	</row>
	<row id="msg_0544_T20R0102_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Giovanni: With the right restraints, your power could belong to me.\rYou will fight when I command it.</language>
	</row>
	<row id="msg_0544_T20R0102_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">No.\rI will decide what I am.\fThe lights burst. The room disappears\nin a wave of psychic force.</language>
	</row>
</body>
